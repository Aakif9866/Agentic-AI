# Vercel container deploy (vercel deploy picks this file up automatically).
# Vercel routes traffic to port 80. Secrets come from Vercel project env vars, never the image.
FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir uv
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

COPY . .

ENV PORT=80
EXPOSE 80
CMD ["sh", "-c", "uv run --no-sync streamlit run ui.py --server.address 0.0.0.0 --server.port ${PORT} --server.headless true"]
